# Base de données PostgreSQL (Railway la fournit automatiquement
# via la variable partagée ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://user:password@host:5432/e_mboppi"

# Clé secrète pour signer les sessions (générez une chaîne aléatoire longue)
JWT_SECRET="remplacez-par-une-chaine-aleatoire-longue-et-unique"

# Numéro WhatsApp de l'administrateur Kmer Vision (format international, sans +)
# Utilisé par les boutons "Devenir vendeur" et "Renouveler mon abonnement"
NEXT_PUBLIC_ADMIN_WHATSAPP="237600000000"

# Secret pour protéger l'endpoint de vérification des abonnements (cron)
CRON_SECRET="remplacez-par-un-secret-different"

# --- Optionnel : à activer plus tard pour l'upload direct de vidéos ---
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# --- Utilisé uniquement pour créer le premier compte admin (scripts/creer-admin.ts) ---
# ADMIN_TELEPHONE="237600000000"
# ADMIN_MOT_DE_PASSE="mot-de-passe-solide"
