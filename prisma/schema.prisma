// E-Mboppi — Schéma de base de données
// Généré pour Kmer Vision

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleUtilisateur {
  CLIENT
  VENDEUR
  ADMIN
}

enum StatutAbonnement {
  ACTIF
  EXPIRE
  EN_ATTENTE_VALIDATION
}

model Utilisateur {
  id             String          @id @default(cuid())
  nom            String
  telephone      String          @unique
  whatsapp       String
  motDePasse     String
  role           RoleUtilisateur @default(CLIENT)
  createdAt      DateTime        @default(now())

  vendeur        Vendeur?

  messagesEnvoyes    Message[] @relation("MessagesEnvoyes")
  messagesRecus      Message[] @relation("MessagesRecus")
  favoris            Favori[]
}

model Vendeur {
  id              String   @id @default(cuid())
  utilisateurId   String   @unique
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id])

  nomBoutique     String
  description     String?
  ville           String?
  logoUrl         String?
  logoPublicId    String?
  createdAt       DateTime @default(now())

  produits        Produit[]
  abonnements     Abonnement[]
}

model Abonnement {
  id                String            @id @default(cuid())
  vendeurId         String
  vendeur           Vendeur           @relation(fields: [vendeurId], references: [id])

  montant           Int               @default(2000)
  dateDebut         DateTime          @default(now())
  dateFin           DateTime
  statut            StatutAbonnement  @default(EN_ATTENTE_VALIDATION)

  preuvePaiementUrl String?
  numeroTransaction String?
  valideParAdminId  String?
  dateValidation    DateTime?

  createdAt         DateTime @default(now())

  @@index([vendeurId])
}

model Produit {
  id           String   @id @default(cuid())
  vendeurId    String
  vendeur      Vendeur  @relation(fields: [vendeurId], references: [id])

  titre        String
  description  String?
  prix         Int
  categorie    String?

  // Jusqu'à 5 photos par article (Cloudinary). photosPublicIds sert à
  // supprimer proprement les fichiers sur Cloudinary quand l'article change.
  photos           String[] @default([])
  photosPublicIds  String[] @default([])

  // Une seule vidéo courte ("reel") par article
  videoUrl         String?
  videoPublicId    String?

  visible      Boolean  @default(true)
  boost        Boolean  @default(false)
  boostedAt    DateTime?
  createdAt    DateTime @default(now())

  favoris      Favori[]

  @@index([vendeurId])
  @@index([categorie])
  @@index([prix])
}

model Message {
  id             String   @id @default(cuid())
  expediteurId   String
  expediteur     Utilisateur @relation("MessagesEnvoyes", fields: [expediteurId], references: [id])
  destinataireId String
  destinataire   Utilisateur @relation("MessagesRecus", fields: [destinataireId], references: [id])

  contenu        String
  lu             Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([expediteurId, destinataireId])
}

model Favori {
  id            String   @id @default(cuid())
  clientId      String
  client        Utilisateur @relation(fields: [clientId], references: [id])
  produitId     String
  produit       Produit  @relation(fields: [produitId], references: [id])
  createdAt     DateTime @default(now())

  @@unique([clientId, produitId])
}
