// E-Mboppi — Schéma de base de données
// Généré pour Kmer Vision

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleUtilisateur {
  CLIENT
  VENDEUR
  ADMIN
}

enum StatutAbonnement {
  ACTIF
  EXPIRE
  EN_ATTENTE_VALIDATION
}

enum StatutStock {
  DISPONIBLE
  STOCK_LIMITE
  RUPTURE_STOCK
}

model Utilisateur {
  id             String          @id @default(cuid())
  nom            String
  telephone      String          @unique
  whatsapp       String
  motDePasse     String
  role           RoleUtilisateur @default(CLIENT)
  createdAt      DateTime        @default(now())

  vendeur        Vendeur?

  favoris            Favori[]
  abonnementsPush    AbonnementPush[]
}

// Souscription aux notifications push du navigateur (Web Push standard,
// via le service worker de la PWA — public/sw.js).
//
// Deux publics distincts partagent ce même modèle :
// - VENDEUR (compte, utilisateurId renseigné) : rappel de renouvellement
//   d'abonnement, etc. — voir scripts/rappel-abonnements.ts.
// - CLIENT (anonyme, appareilId renseigné — même identifiant que
//   Favori/Suivi/Avis, voir lib/appareil.ts) : boutique suivie qui publie un
//   nouvel article, promo en rapport avec sa dernière recherche, etc. —
//   voir lib/notifications.ts.
// Exactement un des deux champs est renseigné selon le type de souscripteur.
model AbonnementPush {
  id            String       @id @default(cuid())

  utilisateurId String?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id])

  appareilId    String?

  endpoint      String       @unique
  p256dh        String
  auth          String

  createdAt     DateTime     @default(now())

  @@index([utilisateurId])
  @@index([appareilId])
}

// Dernière recherche d'un appareil client (une seule ligne par appareil,
// remplacée à chaque nouvelle recherche) — sert uniquement à proposer une
// notification push quand un article en promo correspond à ce que le
// client cherchait récemment (voir lib/notifications.ts). Aucune donnée
// personnelle : juste le terme et, si connue, la catégorie associée.
model RechercheRecente {
  id         String   @id @default(cuid())
  appareilId String   @unique
  terme      String
  categorie  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Vendeur {
  id              String   @id @default(cuid())
  utilisateurId   String   @unique
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id])

  nomBoutique     String
  description     String?
  ville           String?
  logoUrl         String?
  logoPublicId    String?
  createdAt       DateTime @default(now())

  produits        Produit[]
  abonnements     Abonnement[]
  suivis          Suivi[]
  avis            Avis[]
}

model Abonnement {
  id                String            @id @default(cuid())
  vendeurId         String
  vendeur           Vendeur           @relation(fields: [vendeurId], references: [id])

  montant           Int               @default(2000)
  dateDebut         DateTime          @default(now())
  dateFin           DateTime
  statut            StatutAbonnement  @default(EN_ATTENTE_VALIDATION)

  preuvePaiementUrl String?
  numeroTransaction String?
  valideParAdminId  String?
  dateValidation    DateTime?

  // Évite de renvoyer plusieurs fois le même rappel de renouvellement
  // (WhatsApp, 3 jours avant expiration) — remis à false à chaque
  // renouvellement (voir lib/abonnement.ts::validerPaiement).
  rappelEnvoye      Boolean  @default(false)

  createdAt         DateTime @default(now())

  @@index([vendeurId])
}

model Produit {
  id           String   @id @default(cuid())
  vendeurId    String
  vendeur      Vendeur  @relation(fields: [vendeurId], references: [id])

  titre        String
  description  String?
  prix         Int
  categorie    String?

  // Jusqu'à 5 photos par article (Cloudinary). photosPublicIds sert à
  // supprimer proprement les fichiers sur Cloudinary quand l'article change.
  photos           String[] @default([])
  photosPublicIds  String[] @default([])

  // Une seule vidéo courte ("reel") par article
  videoUrl         String?
  videoPublicId    String?

  statutStock  StatutStock @default(DISPONIBLE)
  nature       String?
  enPromo      Boolean  @default(false)

  visible      Boolean  @default(true)
  boost        Boolean  @default(false)
  boostedAt    DateTime?
  createdAt    DateTime @default(now())

  // Statistiques vendeur — vues de la fiche produit et clics sur "Contacter"
  // (WhatsApp), affichées dans le tableau de bord pour motiver les vendeurs
  // à soigner leurs fiches (photos/vidéos).
  vues         Int      @default(0)
  clicsContact Int      @default(0)

  favoris      Favori[]

  @@index([vendeurId])
  @@index([categorie])
  @@index([prix])
}

// Suivi d'une boutique — même logique que Favori (appareil anonyme, pas
// besoin de compte) : un client peut suivre une boutique pour que ses
// articles remontent en priorité dans son fil d'accueil ("Vos boutiques
// suivies"), sans avoir à la rechercher à chaque visite.
model Suivi {
  id            String   @id @default(cuid())
  appareilId    String
  vendeurId     String
  vendeur       Vendeur  @relation(fields: [vendeurId], references: [id])
  createdAt     DateTime @default(now())

  @@unique([appareilId, vendeurId])
  @@index([appareilId])
  @@index([vendeurId])
}

// Avis client sur une boutique — étoiles + commentaire court. Sur un
// marché où l'identité n'est pas vérifiée par pièce, c'est le signal de
// confiance le plus simple avant de contacter un vendeur inconnu.
// Un seul avis par appareil et par boutique (anonyme, pas besoin de compte,
// même logique que Favori/Suivi).
model Avis {
  id          String   @id @default(cuid())
  vendeurId   String
  vendeur     Vendeur  @relation(fields: [vendeurId], references: [id])

  appareilId  String
  nomClient   String?
  note        Int
  commentaire String?

  createdAt   DateTime @default(now())

  @@unique([appareilId, vendeurId])
  @@index([vendeurId])
}

// Profil d'appareil — le pendant "identité" de Favori/Suivi/Avis : un
// pseudo attribué automatiquement au premier passage sur cet appareil
// (cookie anonyme longue durée, voir lib/appareil.ts), que le client peut
// changer à tout moment depuis /mon-profil. Aucune création de compte
// requise — c'est ce qui permet aux favoris, boutiques suivies et avis
// d'afficher un nom plutôt qu'un identifiant technique.
model ProfilAppareil {
  id         String   @id @default(cuid())
  appareilId String   @unique
  pseudo     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Favori {
  id            String   @id @default(cuid())
  // Compte client (optionnel) — gardé pour compatibilité si un système de
  // comptes clients est ajouté plus tard.
  clientId      String?
  client        Utilisateur? @relation(fields: [clientId], references: [id])
  // Identifiant d'appareil anonyme (cookie longue durée) — c'est la clé
  // principale utilisée aujourd'hui : pas besoin de compte pour que les
  // favoris d'un client restent enregistrés sur son appareil.
  appareilId    String?
  produitId     String
  produit       Produit  @relation(fields: [produitId], references: [id])
  createdAt     DateTime @default(now())

  @@unique([clientId, produitId])
  @@unique([appareilId, produitId])
  @@index([appareilId])
}
